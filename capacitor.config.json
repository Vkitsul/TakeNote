{
  "appId": "com.takenote.notes",
  "appName": "TakeNote",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
